---
// 首页顶部公告横幅 - 展示最新一条公告标题
---
<div class="announcement-bar" id="announcement-bar">
  <div class="announcement-bar-content">
    <span class="announcement-bar-badge" data-i18n="news.barPrefix">最新公告</span>
    <a href="/news" class="announcement-bar-title" id="announcement-bar-title"></a>
    <a href="/news" class="announcement-bar-link" data-i18n="news.viewAll">查看全部 →</a>
  </div>
</div>

<script>
  // 加载最新公告标题
  async function loadLatestAnnouncement() {
    try {
      const res = await fetch('/Resources/Announcements/index.json');
      if (!res.ok) return;
      const data = await res.json();
      if (data.announcements && data.announcements.length > 0) {
        const latest = data.announcements[0];
        const fileRes = await fetch(`/Resources/Announcements/${latest.file}`);
        if (!fileRes.ok) return;
        const announcement = await fileRes.json();
        
        const titleEl = document.getElementById('announcement-bar-title');
        if (titleEl) {
          // 存储所有语言的标题
          titleEl.setAttribute('data-title-zh', announcement.title.zh);
          titleEl.setAttribute('data-title-en', announcement.title.en);
          titleEl.setAttribute('data-title-ja', announcement.title.ja);
          // 根据当前语言显示
          const lang = document.documentElement.getAttribute('data-lang') || 'zh';
          titleEl.textContent = announcement.title[lang] || announcement.title.zh;
          titleEl.href = `/news#${latest.id}`;
        }
      }
    } catch (e) {
      console.warn('Failed to load announcement:', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadLatestAnnouncement);
  } else {
    loadLatestAnnouncement();
  }

  // 语言切换时更新标题
  window.addEventListener('langChange', (e) => {
    const lang = e.detail.lang;
    const titleEl = document.getElementById('announcement-bar-title');
    if (titleEl) {
      const title = titleEl.getAttribute(`data-title-${lang}`);
      if (title) titleEl.textContent = title;
    }
  });
</script>

<style>
  .announcement-bar {
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    max-width: 720px;
    z-index: 50;
    background: rgba(5, 30, 45, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 243, 255, 0.2);
    border-radius: 12px;
    pointer-events: auto;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }

  .announcement-bar-content {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
    min-width: 0;
  }

  .announcement-bar-badge {
    background: rgba(0, 243, 255, 0.2);
    color: #00f3ff;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .announcement-bar-title {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .announcement-bar-title:hover {
    color: #00f3ff;
  }

  .announcement-bar-link {
    color: rgba(0, 243, 255, 0.8);
    text-decoration: none;
    font-size: 0.75rem;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .announcement-bar-link:hover {
    color: #00f3ff;
  }

  /* 竖屏 / 手机端适配 */
  @media (max-width: 768px) {
    .announcement-bar {
      width: 85%;
      max-width: none;
      top: 12%;
    }
    .announcement-bar-content {
      padding: 0.5rem 0.75rem;
      gap: 0.4rem;
      font-size: 0.8rem;
    }
    .announcement-bar-link {
      font-size: 0.7rem;
    }
  }
</style>
